    {
      "id": "escalation",
      "weight": 3,
      "name": "Escalation",
      "stages": [
        {
          "hook": "side_a",
          "beat": [
            "It starts small: a job for {a}, the kind lancers take every week."
          ]
        },
        {
          "hook": "side_a",
          "beat": [
            "{b} has noticed you. The next job won't be quiet."
          ],
          "twist": "third_party"
        },
        {
          "hook": "side_b_strike",
          "beat": [
            "{b} moves openly now. This is the fight that decides {hub}."
          ],
          "final": true
        }
      ],
      "on_win": [
        {
          "standing": "$arc.a",
          "add": 1
        },
        {
          "set_flag": "arc_escalation_won"
        }
      ],
      "on_loss": [
        {
          "standing": "$arc.a",
          "add": -1
        },
        {
          "set_flag": "arc_escalation_lost"
        }
      ]
    },
