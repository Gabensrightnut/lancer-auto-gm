class_name SaveStore
extends RefCounted
## Campaign saves and mission autosaves in user://saves/ (outside the game folder, so updates
## never touch them). One folder per campaign:
##   user://saves/<campaign id>/campaign.json   the campaign (Campaign.to_dict)
##   user://saves/<campaign id>/mission.json    autosave of the mission in progress
## Files are written to a temp file first and the old one kept as .bak, so a crash mid-save
## never loses the last good save.

const DIR := "user://saves/"
const MISSION_VERSION := 1

var dir := DIR


func _init(saves_dir: String = DIR) -> void:
	dir = saves_dir


func save_campaign(c: Campaign) -> String:
	c.updated_at = int(Time.get_unix_time_from_system())
	return _write(_folder(c.id).path_join("campaign.json"), c.to_dict())


## {"campaign": Campaign or null, "error": String}
func load_campaign(campaign_id: String) -> Dictionary:
	var r := _read(_folder(campaign_id).path_join("campaign.json"))
	if r["error"] != "":
		return {"campaign": null, "error": r["error"]}
	return Campaign.from_dict(r["data"])


## Saved campaigns, newest first: [{id, name, updated_at, has_mission}]
func list() -> Array:
	var out: Array = []
	if not DirAccess.dir_exists_absolute(dir):
		return out
	for folder in DirAccess.get_directories_at(dir):
		var r := _read(dir.path_join(folder).path_join("campaign.json"))
		if r["error"] != "":
			continue
		out.append({"id": folder, "name": str(r["data"].get("name", folder)), "updated_at": int(r["data"].get("updated_at", 0)),
			"has_mission": FileAccess.file_exists(dir.path_join(folder).path_join("mission.json"))})
	out.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return a["updated_at"] > b["updated_at"])
	return out


## Saves the mission in progress (see MissionAutosave for what's in `data`).
func save_mission(campaign_id: String, data: Dictionary) -> String:
	var d := data.duplicate()
	d["save_version"] = MISSION_VERSION
	d["kind"] = "mission"
	return _write(_folder(campaign_id).path_join("mission.json"), d)


## {"data": Dictionary, "error": String}
func load_mission(campaign_id: String) -> Dictionary:
	var r := _read(_folder(campaign_id).path_join("mission.json"))
	if r["error"] == "" and int(r["data"].get("save_version", 0)) > MISSION_VERSION:
		return {"data": {}, "error": "This mission was saved by a newer version of the game. Update the game to load it."}
	return r


func has_mission(campaign_id: String) -> bool:
	return FileAccess.file_exists(_folder(campaign_id).path_join("mission.json"))


## The mission finished: its autosave isn't needed any more (kept as mission.finished.json).
func clear_mission(campaign_id: String) -> void:
	var path := _folder(campaign_id).path_join("mission.json")
	var done := _folder(campaign_id).path_join("mission.finished.json")
	if FileAccess.file_exists(path):
		if FileAccess.file_exists(done):
			DirAccess.remove_absolute(done)
		DirAccess.rename_absolute(path, done)
	if FileAccess.file_exists(path + ".bak"):
		DirAccess.remove_absolute(path + ".bak")


func _folder(campaign_id: String) -> String:
	# Ids are generated by us; keep them file-name safe anyway.
	var safe := RegEx.create_from_string("[^A-Za-z0-9_-]").sub(campaign_id, "_", true)
	return dir.path_join(safe)


static func _write(path: String, data: Dictionary) -> String:
	DirAccess.make_dir_recursive_absolute(path.get_base_dir())
	var tmp := path + ".tmp"
	var f := FileAccess.open(tmp, FileAccess.WRITE)
	if f == null:
		return "Couldn't write the save (disk full or no permission?)."
	f.store_string(JSON.stringify(data, "\t"))
	f.close()
	if FileAccess.file_exists(path):
		if FileAccess.file_exists(path + ".bak"):
			DirAccess.remove_absolute(path + ".bak")
		DirAccess.rename_absolute(path, path + ".bak")
	if DirAccess.rename_absolute(tmp, path) != OK:
		return "Couldn't finish writing the save."
	return ""


## Reads a save, falling back to the .bak copy if the main file is damaged.
static func _read(path: String) -> Dictionary:
	for p in [path, path + ".bak"]:
		if not FileAccess.file_exists(p):
			continue
		var json := JSON.new()
		if json.parse(FileAccess.get_file_as_string(p)) == OK and json.data is Dictionary:
			return {"data": json.data, "error": ""}
	if FileAccess.file_exists(path):
		return {"data": {}, "error": "The save file is damaged and has no backup."}
	return {"data": {}, "error": "No save found."}
